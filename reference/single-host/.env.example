# Copy to reference/single-host/.env, or let reference/single-host/up.sh write it (with passwords and keys made once). An
# example's settings: the product reads DATABASE_URL, FERRUM_S3_*, AWS_* and the rest of deploy/.env.example from here.
# FERRUM_IMAGE=ghcr.io/cbferrum/ferrum:<commit>
POSTGRES_PASSWORD=change-me
FERRUM_DB_PASSWORD=change-me
# The two addresses the product is given.
DATABASE_URL=postgres://ferrum:change-me@db:5432/ferrum
FERRUM_S3_BUCKET=ferrum
FERRUM_S3_ENDPOINT=http://store:8333
FERRUM_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_ACCESS_KEY=change-me
# How many days of dumps the backup job keeps: what the product is told its backups reach.
BACKUP_KEEP_DAYS=30
PUBLIC_URL=http://localhost:8080
# Durable processes (deploy/temporal.yml), in this stack's database, as its superuser:
TEMPORAL_PG_HOST=db
TEMPORAL_PG_USER=postgres
TEMPORAL_PG_PASSWORD=change-me
