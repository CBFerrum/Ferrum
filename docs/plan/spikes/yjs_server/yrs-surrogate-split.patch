+/// Splits at a UTF-16 offset as Yjs does: a surrogate pair cut in two becomes U+FFFD on each side.
+fn split_utf16_lossy(str: &str, offset: usize) -> (String, String) {
+    let units: Vec<u16> = str.encode_utf16().collect();
+    (String::from_utf16_lossy(&units[..offset]), String::from_utf16_lossy(&units[offset..]))
