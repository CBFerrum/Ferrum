{
  "name": "after-commit",
  "version": "0.1.0",
  "description": "Calls a provider after the document commits, never from inside its transaction",
  "config": {"provider_url": ""},
  "hooks": [{"entity": "Customer", "stage": "validate"}],
  "routes": [{"path": "/call", "public": true}],
  "subscriptions": ["plugin.after-commit.provider"],
  "http_hosts": ["127.0.0.1"],
  "permissions": [{"entity": "Customer", "read": true}]
}
