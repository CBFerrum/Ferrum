# Copy to deploy/.env and replace every value.
# Database superuser (administration only) and the application role Ferrum connects as.
# Use letters and digits only.
POSTGRES_PASSWORD=change-me-to-a-long-random-password
FERRUM_DB_PASSWORD=change-me-to-another-long-random-password
# openssl rand -base64 48
JWT_SECRET=
# openssl rand -base64 32 — seals secret fields (mail passwords, API keys). Keep it: values sealed
# with a lost key must be entered again.
FERRUM_SECRET_KEY=
# Leave empty to disable tenant creation over HTTP (use `ferrum task create_tenant` instead).
FERRUM_BOOTSTRAP_TOKEN=
PUBLIC_URL=http://localhost:8080
# The image, pinned to a commit CI published (docs/operations.md, "Images"). Unset, it is
# `latest`, which moves.
# FERRUM_IMAGE=ghcr.io/cbferrum/ferrum:<commit>
FERRUM_PORT=8080
# Browser editors (deploy/editors.yml): the editor server as browsers reach it, on an origin of its
# own, e.g. https://editors.example.com or http://<host>:8090.
# FERRUM_EDITORS_URL=
# Meetings (deploy/meet.yml): LiveKit as browsers reach it (wss:// behind your TLS proxy), and the
# API key and secret it and Ferrum share (the secret at least 32 characters: openssl rand -hex 32).
# FERRUM_MEET_URL=
# FERRUM_MEET_KEY=ferrum
# FERRUM_MEET_SECRET=
# Recordings through LiveKit Egress, which you run with its storage; and LiveKit's API as the server
# reaches it, when not at FERRUM_MEET_URL.
# FERRUM_MEET_RECORDINGS=true
# FERRUM_MEET_API_URL=http://livekit:7880
# The address LiveKit gives browsers, when STUN would find the wrong one (and false offline).
# FERRUM_MEET_NODE_IP=
# FERRUM_MEET_EXTERNAL_IP=true
# Hosted mail (deploy/mail.yml): the Stalwart administrator its first-start setup gives you.
FERRUM_MAIL_ADMIN=
FERRUM_MAIL_ADMIN_SECRET=
# The mail server's public host name (mail.example.com), shown to people setting up mail programs.
FERRUM_MAIL_HOST=
# Online editing of Word, Excel and PowerPoint files (the `office` service) and the PDF renderer
# (`pdf`) are on. Turn one off by setting it, empty (docs/operations.md, "Online editing"):
# FERRUM_OFFICE_URL=
# FERRUM_PDF_URL=
# The editor as browsers reach it, on an origin of its own: https://office.example.com behind your
# TLS proxy (then OFFICE_PUBLIC_HOST=office.example.com and OFFICE_TLS_TERMINATED=true), or
# http://<this host>:9980 on a single host (OFFICE_PUBLIC_HOST=<this host>:9980). Set both whenever
# PUBLIC_URL is not localhost.
# OFFICE_PUBLIC_URL=
# OFFICE_PUBLIC_HOST=
# OFFICE_TLS_TERMINATED=false
# OFFICE_PORT=9980
# Publish the editor on this address only (127.0.0.1 when your proxy runs on this host).
# OFFICE_BIND=0.0.0.0
# The WOPI proof key (deploy/preflight.sh --generate makes it).
# OFFICE_PROOF_KEY=./office-proof-key
# The editor's image tag (an exact version: docs/operations.md, "Online editing"), memory limit.
# COLLABORA_TAG=26.04.5.2.1
# OFFICE_MEMORY=2g
