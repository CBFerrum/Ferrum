[Unit]
Description=Ferrum site runtime
After=network-online.target
Wants=network-online.target

[Service]
User=ferrum-site
ExecStart=/var/lib/ferrum-site/bin/ferrum-site run --config /etc/ferrum-site/site.yaml
Restart=always
RestartSec=5
# It writes only its journal, and its own binary when `update_keys` lets it take signed releases.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/ferrum-site

[Install]
WantedBy=multi-user.target
